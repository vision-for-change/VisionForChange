{
  "expo": {
    "name": "Vision for Change",
    "slug": "vision-for-change",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "visionforchange",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#16201F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.visionforchange.app"
    },
    "android": {
      "package": "org.visionforchange.app",
      "adaptiveIcon": {
        "backgroundColor": "#16201F"
      },
      "edgeToEdgeEnabled": true
    },
    "plugins": ["expo-router", "expo-font"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
